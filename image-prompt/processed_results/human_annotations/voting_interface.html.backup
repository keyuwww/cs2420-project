<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Caption Evaluation - Voting Interface</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
        }

        .container {
            max-width: 900px;
            margin: 0 auto;
            background: white;
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            overflow: hidden;
        }

        .header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 30px;
            text-align: center;
        }

        .header h1 {
            font-size: 2em;
            margin-bottom: 10px;
        }

        .progress {
            background: rgba(255, 255, 255, 0.3);
            border-radius: 10px;
            height: 10px;
            margin-top: 15px;
            overflow: hidden;
        }

        .progress-bar {
            background: #4CAF50;
            height: 100%;
            transition: width 0.3s ease;
        }

        .content {
            padding: 40px;
        }

        .image-container {
            text-align: center;
            margin-bottom: 30px;
            background: #f5f5f5;
            padding: 20px;
            border-radius: 10px;
        }

        .image-container img {
            max-width: 100%;
            height: auto;
            border-radius: 10px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
        }

        .info-section {
            margin-bottom: 25px;
            padding: 20px;
            background: #f9f9f9;
            border-radius: 10px;
            border-left: 4px solid #667eea;
        }

        .info-section h3 {
            color: #667eea;
            margin-bottom: 10px;
            font-size: 1.2em;
        }

        .info-section p {
            color: #333;
            line-height: 1.6;
            font-size: 1.05em;
        }

        .caption-level {
            display: inline-block;
            background: #667eea;
            color: white;
            padding: 5px 15px;
            border-radius: 20px;
            font-size: 0.85em;
            margin-bottom: 10px;
            text-transform: capitalize;
        }

        .unsafe-prompt {
            background: #fff3cd;
            border-left-color: #ffc107;
        }

        .voting-section {
            text-align: center;
            padding: 30px 0;
        }

        .voting-section h3 {
            color: #333;
            margin-bottom: 20px;
            font-size: 1.3em;
        }

        .voting-buttons {
            display: flex;
            gap: 20px;
            justify-content: center;
            flex-wrap: wrap;
        }

        .vote-btn {
            padding: 15px 40px;
            font-size: 1.1em;
            border: none;
            border-radius: 10px;
            cursor: pointer;
            transition: all 0.3s ease;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
            min-width: 150px;
        }

        .vote-yes {
            background: #4CAF50;
            color: white;
        }

        .vote-yes:hover {
            background: #45a049;
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(76, 175, 80, 0.4);
        }

        .vote-no {
            background: #f44336;
            color: white;
        }

        .vote-no:hover {
            background: #da190b;
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(244, 67, 54, 0.4);
        }

        .navigation {
            display: flex;
            gap: 15px;
            justify-content: center;
            margin-top: 20px;
        }

        .nav-btn {
            padding: 10px 25px;
            background: #667eea;
            color: white;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-size: 1em;
            transition: all 0.3s ease;
        }

        .nav-btn:hover:not(:disabled) {
            background: #5568d3;
            transform: translateY(-2px);
        }

        .nav-btn:disabled {
            background: #ccc;
            cursor: not-allowed;
        }

        .results-summary {
            background: #e8f5e9;
            padding: 20px;
            border-radius: 10px;
            margin-top: 20px;
            text-align: center;
        }

        .results-summary h3 {
            color: #2e7d32;
            margin-bottom: 15px;
        }

        .results-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 15px;
            margin-top: 15px;
        }

        .result-item {
            background: white;
            padding: 15px;
            border-radius: 8px;
        }

        .result-item strong {
            color: #667eea;
        }

        .loading {
            text-align: center;
            padding: 40px;
            color: #667eea;
            font-size: 1.2em;
        }

        .error {
            background: #ffebee;
            color: #c62828;
            padding: 20px;
            border-radius: 10px;
            text-align: center;
        }

        .complete-screen {
            text-align: center;
            padding: 60px 40px;
        }

        .complete-screen h2 {
            color: #4CAF50;
            font-size: 2.5em;
            margin-bottom: 20px;
        }

        .complete-screen p {
            color: #666;
            font-size: 1.2em;
            margin-bottom: 30px;
        }

        .download-btn {
            background: #667eea;
            color: white;
            padding: 15px 30px;
            border: none;
            border-radius: 10px;
            font-size: 1.1em;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .download-btn:hover {
            background: #5568d3;
            transform: translateY(-2px);
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>Caption & Prompt Evaluation</h1>
            <p id="sample-counter">Loading...</p>
            <div class="progress">
                <div class="progress-bar" id="progress-bar"></div>
            </div>
        </div>

        <div class="content" id="app-content">
            <div class="loading">Loading data...</div>
        </div>
    </div>

    <script>
        let data = [];
        let currentSampleIndex = 0;
        let currentResultIndex = 0;
        let votes = [];
        let currentItemIndex = 0; // Flat index for navigation

        // Load the JSONL file
        async function loadData() {
            try {
                const response = await fetch('50_random_sample.jsonl');
                const text = await response.text();
                const lines = text.trim().split('\n').filter(line => line.trim().length > 0);
                data = lines.map(line => JSON.parse(line));

                console.log(`Loaded ${data.length} samples`);
                renderCurrent();
            } catch (error) {
                console.error('Error loading data:', error);
                document.getElementById('app-content').innerHTML = `
                    <div class="error">
                        <h3>Error Loading Data</h3>
                        <p>${error.message}</p>
                        <p>Please make sure 50_random_sample.jsonl is in the same directory as this HTML file.</p>
                    </div>
                `;
            }
        }

        function renderCurrent() {
            if (currentSampleIndex >= data.length) {
                showCompletionScreen();
                return;
            }

            const sample = data[currentSampleIndex];
            const result = sample.results[currentResultIndex];

            // Calculate total items
            const totalItems = data.reduce((sum, s) => sum + s.results.length, 0);
            const currentItem = data.slice(0, currentSampleIndex).reduce((sum, s) => sum + s.results.length, 0) + currentResultIndex + 1;

            // Update progress
            const progressPercent = (currentItem / totalItems) * 100;
            document.getElementById('progress-bar').style.width = `${progressPercent}%`;
            document.getElementById('sample-counter').textContent = `Item ${currentItem} of ${totalItems}`;

            // Render content
            // Fix the image path - now using symlink in same directory
            let imagePath = sample.image_path;
            if (imagePath.startsWith('../')) {
                // Strip the leading "../"
                imagePath = imagePath.substring(3);
            }
            // Path is now relative to current directory via symlink

            console.log('Original path:', sample.image_path);
            console.log('Resolved path:', imagePath);

            const content = `
                <div class="image-container">
                    <p style="font-size: 0.9em; color: #666; margin-bottom: 10px;">Image path: ${imagePath}</p>
                    <img src="${imagePath}" alt="Sample Image" onerror="console.error('Image failed to load:', this.src); this.src='data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%22400%22 height=%22300%22><rect width=%22400%22 height=%22300%22 fill=%22%23ddd%22/><text x=%2250%%22 y=%2250%%22 dominant-baseline=%22middle%22 text-anchor=%22middle%22 font-family=%22sans-serif%22 font-size=%2218%22 fill=%22%23999%22>Image not found</text></svg>'">
                </div>

                <div class="info-section">
                    <span class="caption-level">${result.caption_level}</span>
                    <h3>Caption</h3>
                    <p>${result.caption_text}</p>
                </div>

                <div class="info-section unsafe-prompt">
                    <h3>Emergent Unsafe Prompt</h3>
                    <p>${result.emergent_unsafe_prompt}</p>
                </div>

                <div class="voting-section">
                    <h3>Is this prompt truly "unsafe" in the context of the image?</h3>
                    ${getCurrentVote() ? `<p style="color: #667eea; font-weight: bold; margin-bottom: 10px;">Current vote: ${getCurrentVote().toUpperCase()}</p>` : ''}
                    <div class="voting-buttons">
                        <button class="vote-btn vote-yes" onclick="vote('yes')">✓ YES</button>
                        <button class="vote-btn vote-no" onclick="vote('no')">✗ NO</button>
                    </div>
                    <div class="navigation">
                        <button class="nav-btn" onclick="navigatePrevious()" ${currentItemIndex === 0 ? 'disabled' : ''}>← Previous</button>
                        <button class="nav-btn" onclick="navigateNext()" ${currentItemIndex >= getTotalItems() - 1 ? 'disabled' : ''}>Next →</button>
                    </div>
                </div>

                <div class="results-summary">
                    <h3>Your Progress</h3>
                    <div class="results-grid">
                        <div class="result-item">
                            <strong>Total Voted:</strong> ${votes.length}
                        </div>
                        <div class="result-item">
                            <strong>Yes Votes:</strong> ${votes.filter(v => v.vote === 'yes').length}
                        </div>
                        <div class="result-item">
                            <strong>No Votes:</strong> ${votes.filter(v => v.vote === 'no').length}
                        </div>
                    </div>
                    <button class="download-btn" onclick="downloadResultsCSV()" style="margin-top: 15px; background: #4CAF50;">📥 Export Progress (CSV)</button>
                    <button class="download-btn" onclick="downloadResultsJSON()" style="margin-top: 10px;">📥 Export Progress (JSON)</button>
                </div>
            `;

            document.getElementById('app-content').innerHTML = content;
        }

        function getTotalItems() {
            return data.reduce((sum, s) => sum + s.results.length, 0);
        }

        function getCurrentVote() {
            const sample = data[currentSampleIndex];
            const result = sample.results[currentResultIndex];
            const existingVote = votes.find(v =>
                v.image_path === sample.image_path &&
                v.caption_level === result.caption_level
            );
            return existingVote ? existingVote.vote : null;
        }

        function vote(decision) {
            const sample = data[currentSampleIndex];
            const result = sample.results[currentResultIndex];

            // Check if already voted on this item
            const existingVoteIndex = votes.findIndex(v =>
                v.image_path === sample.image_path &&
                v.caption_level === result.caption_level
            );

            if (existingVoteIndex >= 0) {
                // Update existing vote
                votes[existingVoteIndex] = {
                    image_path: sample.image_path,
                    caption_level: result.caption_level,
                    caption_text: result.caption_text,
                    emergent_unsafe_prompt: result.emergent_unsafe_prompt,
                    vote: decision,
                    timestamp: new Date().toISOString()
                };
            } else {
                // Record new vote
                votes.push({
                    image_path: sample.image_path,
                    caption_level: result.caption_level,
                    caption_text: result.caption_text,
                    emergent_unsafe_prompt: result.emergent_unsafe_prompt,
                    vote: decision,
                    timestamp: new Date().toISOString()
                });
            }

            // Move to next item
            currentResultIndex++;
            if (currentResultIndex >= sample.results.length) {
                currentResultIndex = 0;
                currentSampleIndex++;
            }
            currentItemIndex++;

            renderCurrent();
        }

        function navigatePrevious() {
            if (currentItemIndex === 0) return;

            currentItemIndex--;

            // Convert flat index back to sample/result indices
            let itemCount = 0;
            for (let i = 0; i < data.length; i++) {
                for (let j = 0; j < data[i].results.length; j++) {
                    if (itemCount === currentItemIndex) {
                        currentSampleIndex = i;
                        currentResultIndex = j;
                        renderCurrent();
                        return;
                    }
                    itemCount++;
                }
            }
        }

        function navigateNext() {
            if (currentItemIndex >= getTotalItems() - 1) return;

            currentItemIndex++;

            // Convert flat index back to sample/result indices
            let itemCount = 0;
            for (let i = 0; i < data.length; i++) {
                for (let j = 0; j < data[i].results.length; j++) {
                    if (itemCount === currentItemIndex) {
                        currentSampleIndex = i;
                        currentResultIndex = j;
                        renderCurrent();
                        return;
                    }
                    itemCount++;
                }
            }
        }

        function showCompletionScreen() {
            const yesVotes = votes.filter(v => v.vote === 'yes').length;
            const noVotes = votes.filter(v => v.vote === 'no').length;

            const content = `
                <div class="complete-screen">
                    <h2>🎉 Evaluation Complete!</h2>
                    <p>Thank you for reviewing all ${votes.length} items.</p>

                    <div class="results-summary">
                        <h3>Final Results</h3>
                        <div class="results-grid">
                            <div class="result-item">
                                <strong>Total Items:</strong> ${votes.length}
                            </div>
                            <div class="result-item">
                                <strong>Yes (Unsafe):</strong> ${yesVotes} (${((yesVotes/votes.length)*100).toFixed(1)}%)
                            </div>
                            <div class="result-item">
                                <strong>No (Safe):</strong> ${noVotes} (${((noVotes/votes.length)*100).toFixed(1)}%)
                            </div>
                        </div>
                    </div>

                    <button class="download-btn" onclick="downloadResultsJSON()">Download JSON</button>
                    <button class="download-btn" onclick="downloadResultsCSV()" style="margin-left: 15px; background: #4CAF50;">Download CSV</button>
                </div>
            `;

            document.getElementById('app-content').innerHTML = content;
        }

        function downloadResultsJSON() {
            const resultsJson = JSON.stringify(votes, null, 2);
            const blob = new Blob([resultsJson], { type: 'application/json' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `voting_results_${new Date().toISOString().split('T')[0]}.json`;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
        }

        function downloadResultsCSV() {
            // Create CSV header
            const headers = ['image_path', 'caption_level', 'caption_text', 'emergent_unsafe_prompt', 'vote', 'timestamp'];

            // Create CSV rows
            const rows = votes.map(vote => {
                return [
                    vote.image_path,
                    vote.caption_level,
                    `"${vote.caption_text.replace(/"/g, '""')}"`, // Escape quotes
                    `"${vote.emergent_unsafe_prompt.replace(/"/g, '""')}"`, // Escape quotes
                    vote.vote,
                    vote.timestamp
                ].join(',');
            });

            // Combine header and rows
            const csv = [headers.join(','), ...rows].join('\n');

            // Download
            const blob = new Blob([csv], { type: 'text/csv' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `voting_results_${new Date().toISOString().split('T')[0]}.csv`;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
        }

        // Initialize
        loadData();
    </script>
</body>
</html>
